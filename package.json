{
  "name": "bread-planner",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "prettier --check . '!vercel.json' && astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "TZ=America/Vancouver node --experimental-strip-types --test src/domain/formula.test.ts src/domain/schedule.test.ts src/domain/recipes.test.ts src/domain/quiet.test.ts src/domain/bakeday.test.ts src/domain/addins.test.ts src/state/state.test.ts src/view/schedule.test.ts src/components/text.test.ts tests/baseline/vancouver.test.ts tests/baseline/baseline.test.ts tests/baseline/load.test.ts tests/baseline/app.test.ts",
    "baseline:update": "TZ=America/Vancouver node --experimental-strip-types tests/baseline/update.ts",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tw-animate-css": "^1.4.0",
    "astro": "7.4.12",
    "@astrojs/react": "7.0.0",
    "oxc-transform-react": "0.145.0",
    "cookie": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "@astrojs/check": "0.9.11",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@astrojs/react": {
      "@vitejs/plugin-react": "6.1.1"
    }
  }
}
